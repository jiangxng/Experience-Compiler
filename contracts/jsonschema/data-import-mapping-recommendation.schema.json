{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evo.local/contracts/ec/data-import-mapping-recommendation/0.1.0",
  "title": "Data Import Mapping Recommendation v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceColumn",
    "targetFieldId",
    "confidence",
    "supportCount",
    "conflictCount",
    "supportingRecordIds",
    "rationale",
    "advisoryOnly"
  ],
  "properties": {
    "sourceColumn": { "type": "string", "minLength": 1 },
    "targetFieldId": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "supportCount": { "type": "integer", "minimum": 1 },
    "conflictCount": { "type": "integer", "minimum": 0 },
    "supportingRecordIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "advisoryOnly": { "const": true }
  }
}
