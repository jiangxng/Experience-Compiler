{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ec:evo-event:0.1.0",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "tenantId",
    "subject",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "type": "string"
    },
    "eventVersion": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "subject": {
      "type": "object"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
