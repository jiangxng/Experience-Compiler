{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ec:knowledge-record:0.1.0",
  "title": "EC Knowledge Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordId",
    "kind",
    "subject",
    "predicate",
    "scope",
    "provenance",
    "confidence",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "recordId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "raw",
        "claim",
        "fact",
        "rule",
        "policy",
        "ontology",
        "case",
        "decision",
        "outcome",
        "lesson",
        "pattern",
        "practice",
        "hypothesis",
        "preference",
        "recommendation"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "candidate",
        "accepted",
        "disputed",
        "superseded",
        "quarantined",
        "archived"
      ]
    },
    "scope": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "temporal": {
      "type": "object"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
