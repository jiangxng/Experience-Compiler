{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ec:learning-strategy:0.1.0",
  "type": "object",
  "required": [
    "strategyId",
    "version",
    "steps",
    "reviewPolicy",
    "confidenceThreshold"
  ],
  "properties": {
    "strategyId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviewPolicy": {
      "type": "string"
    },
    "confidenceThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true
}
