{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.evo.local/evo-semantic/1.0/schema.json",
  "title": "EVO Experience Semantic Snapshot 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "application",
    "command",
    "fields"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "inputVersion"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "inputVersion": {
          "type": "string"
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "semanticType",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "semanticType": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {},
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
